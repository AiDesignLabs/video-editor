{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "composite": false,
    "rootDir": "..",
    "paths": {
      "@video-editor/*": [
        "packages/*/src/index.ts"
      ]
    },
    "typeRoots": [
      "../types",
      "../node_modules/@types"
    ],
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "auto-imports.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}
