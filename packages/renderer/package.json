{
  "name": "@video-editor/renderer",
  "type": "module",
  "version": "1.0.0-beta.7",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./*"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config ./vitest.config.ts",
    "test:browser": "vitest run --config ./vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@vue/reactivity": "catalog:"
  },
  "dependencies": {
    "@video-editor/media": "workspace:*",
    "@video-editor/protocol": "workspace:*",
    "@video-editor/shared": "workspace:*",
    "opfs-tools": "catalog:",
    "pixi-filters": "catalog:",
    "pixi.js": "catalog:"
  },
  "devDependencies": {
    "@vue/reactivity": "catalog:",
    "gl-transitions": "catalog:"
  }
